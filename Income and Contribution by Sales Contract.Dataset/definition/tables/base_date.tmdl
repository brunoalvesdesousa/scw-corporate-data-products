	column latest_date = ```
			
			    IF(base_date[Month Year] = MAX(base_date[Month Year]),
			                     "Latest",
			                     FORMAT(base_date[Month Year],"MMM")
			   )
			```
		lineageTag: e3c07a4d-5513-4976-b51d-a4edc85a10e0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition base_date = calculated
		mode: import
		source =
				
				VAR FYStart = "04"
				VAR todayreference = TODAY()
				VAR FirstYear = -- Customizes the first year to use
				    MIN(data_oracle_income[Month])
				VAR LastYear = -- Customizes the last year to use
				 todayreference
				RETURN
				ADDCOLUMNS (
				 FILTER (
				 CALENDARAUTO (),
				 AND([Date] >= FirstYear,[Date] <= todayreference)),
				 "Year", DATE ( YEAR ( [Date] ), 12, 31 ),
				 "Month Year", EOMONTH ( [Date], 0 ),
				 "Month", FORMAT ( [Date], "mmm" ),
				 "Month Number", MONTH ( [Date] ),
				 "Day of Week", FORMAT ( [Date], "ddd" ),
				 "Day of Week Number", WEEKDAY ( [Date],1),
				 "Day of the Month Number", DAY([Date]),
				 "Financial Year", IF(FYStart <= FORMAT([Date],"MM"), YEAR([Date]) & "-" & YEAR([Date])+1 ,YEAR([Date])-1 & "-" & YEAR([Date])
				))

	annotation PBI_Id = eaa22f27e0564352bf4b70117d9c3dac

