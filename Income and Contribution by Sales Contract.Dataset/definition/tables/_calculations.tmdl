			    IF(MAX(base_date[Financial Year])= "2027-2028",SUM(data_salesforce_mdt_detail[X2027_28_Value__c]),
			    IF(MAX(base_date[Financial Year])= "2028-2029",SUM(data_salesforce_mdt_detail[X2028_29_Value__c]),
			    IF(MAX(base_date[Financial Year])= "2029-2030",SUM(data_salesforce_mdt_detail[X2029_30_Value__c]),
			    IF(MAX(base_date[Financial Year])= "2030-2031",SUM(data_salesforce_mdt_detail[X2030_31_Value__c]),
			    IF(MAX(base_date[Financial Year])= "2031-2032",SUM(data_salesforce_mdt_detail[X2031_32_Value__c]),
			    IF(MAX(base_date[Financial Year])= "2032-2033",SUM(data_salesforce_mdt_detail[X2032_33_Value__c]),
			    IF(MAX(base_date[Financial Year])= "2033-2034",SUM(data_salesforce_mdt_detail[X2033_34_Value__c]),
			    IF(MAX(base_date[Financial Year])= "2034-2035",SUM(data_salesforce_mdt_detail[X2034_35_Value__c]),
			    IF(MAX(base_date[Financial Year])= "2035-2036",SUM(data_salesforce_mdt_detail[X2035_36_Value__c]),
			    IF(MAX(base_date[Financial Year])= "2036-2037",SUM(data_salesforce_mdt_detail[X2036_37_Value__c]),
			    IF(MAX(base_date[Financial Year])= "2037-2038",SUM(data_salesforce_mdt_detail[X2037_38_Value__c]),
			    IF(MAX(base_date[Financial Year])= "2038-2039",SUM(data_salesforce_mdt_detail[X2038_39_Value__c]),
			    IF(MAX(base_date[Financial Year])= "2039-2040",SUM(data_salesforce_mdt_detail[X2039_40_Value__c])
			)))))))))))))))))))))))))
			```
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: ddda4d4a-4db0-4d0d-b9bb-db44c7e84549

