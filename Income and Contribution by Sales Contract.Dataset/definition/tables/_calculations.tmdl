	measure calc_contribution = ```
			
			    if(
			    AND(
			        ISBLANK([calc_income]),
			        ISBLANK([calc_cost_all])),
			        "",
			        (_calculations[calc_income]-_calculations[calc_cost_all]))
			```
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: a6e4055a-604f-4a3e-b637-6a464f4a1852

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure calc_smarttime_fresheness = ```
			
			    IF(
			        DATEDIFF(TODAY(),[calc_smarttime_latestdate],DAY)>1,
			        "#F80101",
			        "#78be20")
			```
		lineageTag: 42ff4112-f35f-4bd8-9594-bb36a87b863f

