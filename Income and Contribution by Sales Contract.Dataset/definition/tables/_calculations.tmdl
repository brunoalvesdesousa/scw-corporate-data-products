	measure calc_valid_cost_income =
			
			IF(
			    NOT(ISBLANK(SUM(data_smarttime[Cost]))) ||
			    NOT(ISBLANK(SUM(data_oracle_income[Amount]))) ||
			    NOT(ISBLANK(sum(data_oracle_direct_non_pay[Amount]))),
			    "True",
			    "False")
