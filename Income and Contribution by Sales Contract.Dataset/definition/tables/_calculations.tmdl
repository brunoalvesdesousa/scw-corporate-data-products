table _calculations
	lineageTag: 138318f6-1750-4ec5-8642-4d2f9aed0319

	measure calc_contribution_% = ```
			
			    IF(
			        ISBLANK([calc_income]) ||
			        [calc_income]=0 ||
			        ISBLANK([calc_cost_all]) ||
			        [calc_cost_all]=0,
			        "",
			(_calculations[calc_income]-_calculations[calc_cost_all])/_calculations[calc_income])
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 365a73a6-5c78-4c67-a2ad-73637e6a17bd

		changedProperty = IsHidden

	measure txt_contribution_% = "% Contribution: " & FORMAT((_calculations[calc_contribution_%]*100),"#,##0.00") & "%"
		lineageTag: a8996365-46bd-4651-90fd-042c482605de

		changedProperty = IsHidden

	measure calc_cost_all =
			
			SUM(data_smarttime[Cost])+[calc_agency_cost]+[calc_exception_cost]+_calculations[calc_oracle_non_pay]
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 676c6dad-d3af-4ae8-a461-25ddd29d2e5a

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

