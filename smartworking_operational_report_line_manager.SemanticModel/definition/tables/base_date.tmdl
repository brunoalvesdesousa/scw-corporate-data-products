table base_date
	lineageTag: ce72862b-1c9b-4f0d-abc6-4f3917a2e0a8
	dataCategory: Time

	measure calc_late_submission = ```
			
			    IF(
			        MAX(data_smarttime[Activity_Submitted_Date])>MAX(base_date[Financial Week Start Plus 7]),
			        "red",
			        "green"
			    )
			
			```
		lineageTag: 70b05ce8-4343-413f-ae65-7b3690e48d67

	measure Count_Days_in_Month =
			CALCULATE(DISTINCTCOUNT(base_date[Date]),
			    base_date[Day of Week Number]<>6 && base_date[Day of Week Number]<>7)
		formatString: 0
		lineageTag: 41aa3277-330b-4b9b-a9dd-852cf1df1ce6

