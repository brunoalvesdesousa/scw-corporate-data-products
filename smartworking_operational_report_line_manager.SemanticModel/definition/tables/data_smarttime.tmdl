	column calc_burn_non_invoiceable =
			
			IF(
			    data_smarttime[Activity_Non_Invoiceable]=TRUE,
			    data_smarttime[Day_Rate]*data_smarttime[calc_smarttime_days],
			    0
			)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: e9de4b4e-b909-4cd7-b5ad-949f08ada822
		summarizeBy: sum

		changedProperty = Name

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	column calc_burn_invoiceable =
			
			IF(
			    data_smarttime[Activity_Non_Invoiceable]=FALSE,
			    data_smarttime[Day_Rate]*data_smarttime[calc_smarttime_days],
