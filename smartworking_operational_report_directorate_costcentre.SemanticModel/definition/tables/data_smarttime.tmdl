	column calc_timesheet_due_by =
			
			data_smarttime[Timesheet_Start]+7
		formatString: dd/mm
		lineageTag: 28e899ba-521a-4c98-9f3c-f8a3c3d3ea62
		summarizeBy: none

		changedProperty = Name

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isCustom":true}

	column calc_lateness_conditional_formatting = ```
			
			IF(
			    AND(
			        ISBLANK(data_smarttime[calc_timesheet_due_by]),
			        ISBLANK(data_smarttime[Timesheet_Closed_Date])
			    ),
			    "grey",
			    IF(
			            ISBLANK(data_smarttime[Timesheet_Closed_Date]) &&
			            NOT(ISBLANK(data_smarttime[calc_timesheet_due_by])) &&
			            data_smarttime[calc_timesheet_due_by]<TODAY(),        
			        "red",
			        IF(
			            DATEDIFF(data_smarttime[calc_timesheet_due_by],data_smarttime[Timesheet_Closed_Date],DAY)>=1,
			            "orange",
			            ""
			        )
			    )
			)
			```
		lineageTag: 5ab44cd6-7c4f-4167-af3b-49210c5babf8
		summarizeBy: none

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column Column
		type: calculated
		lineageTag: 1a9ac9f0-e6cc-42ba-8994-6f138562c9e9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	column calc_lateness = ```
			
			IF(
			    AND(
			        ISBLANK(data_smarttime[calc_timesheet_due_by]),
			        ISBLANK(data_smarttime[Timesheet_Closed_Date])
			    ),
			    "not due",
			    IF(
			            ISBLANK(data_smarttime[Timesheet_Closed_Date]) &&
			            NOT(ISBLANK(data_smarttime[calc_timesheet_due_by])) &&
			            data_smarttime[calc_timesheet_due_by]<TODAY(),        
			        "unsubmitted",
			        IF(
			            DATEDIFF(data_smarttime[calc_timesheet_due_by],data_smarttime[Timesheet_Closed_Date],DAY)>=1,
			            "late",
			            "on time"
			        )
			    )
			)
			```
		lineageTag: 6b37ac92-7cb8-4297-91a3-58cc28d78a0e
		summarizeBy: none

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column test =
			
			DATEDIFF(data_smarttime[calc_timesheet_due_by],data_smarttime[Activity_Submitted_Date],DAY)
		formatString: 0
		lineageTag: ba3fcb78-7fe1-458b-bc5a-cd1a52ea18f7
		summarizeBy: sum

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column work_activity_name_wanumber = "WA" & data_smarttime[Work_Activity_Id] & " - " & data_smarttime[Work_Activity_Name]
		lineageTag: c7785a85-afdf-44e6-af17-b4449ea9db46
		summarizeBy: none

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column calc_smarttime_days = data_smarttime[Activity_Hours]/7.5
		formatString: 0.00
		lineageTag: ca91cd93-377b-4576-a251-62ab5d1022fe
		summarizeBy: sum

		changedProperty = Name

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

	column person_fullname2 =
			
			data_smarttime[Person_LastName] & ", " & data_smarttime[Person_FirstName]
		lineageTag: 07dac4cc-6760-4a26-8cc0-9e4fd645cceb
		summarizeBy: none

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column calc_burn_non_invoiceable =
			
			IF(
			    data_smarttime[Activity_Non_Invoiceable]=TRUE,
			    data_smarttime[Day_Rate]*data_smarttime[calc_smarttime_days],
			    0
			)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: e9de4b4e-b909-4cd7-b5ad-949f08ada822
		summarizeBy: sum

		changedProperty = Name

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	column calc_burn_invoiceable =
			
			IF(
			    data_smarttime[Activity_Non_Invoiceable]=FALSE,
			    data_smarttime[Day_Rate]*data_smarttime[calc_smarttime_days],
			    0
			)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		lineageTag: 8ce70e7e-3221-4ba6-95f5-2602cfe97848
		summarizeBy: sum

		changedProperty = Name

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

