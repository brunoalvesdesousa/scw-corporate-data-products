	measure calc_timesheet_count = ```
			
			    DISTINCTCOUNT(data_smarttime[Timesheet_Id])
			```
		formatString: 0
		lineageTag: 9dafc540-e96b-4099-87ea-56014542b8f7

		changedProperty = Name

	measure calc_compliance =
			
			1-
			DIVIDE(
			    CALCULATE([calc_timesheet_count],data_smarttime[calc_lateness]="unsubmitted"),
			    [calc_timesheet_count]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5bb47a37-49ae-4812-a5a3-758395d6fb59

		changedProperty = Name

		changedProperty = FormatString

	measure calc_submitted_timesheets = ```
			
			CALCULATE(
			    [calc_timesheet_count],
			    data_smarttime[calc_lateness] = "late" || data_smarttime[calc_lateness] = "on time"
			)
			
			```
		formatString: 0
		lineageTag: e3c5598b-d4c7-4da6-b480-34bab0831a5b

		changedProperty = Name

	measure calc_unsubmitted_timesheets =
			
			CALCULATE(
