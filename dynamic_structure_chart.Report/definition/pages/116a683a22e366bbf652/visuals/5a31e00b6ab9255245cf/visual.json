            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Summary Text",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#005eb8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This report draws information directly from the SCW Electronic Staff Record (ESR) reporting structure and all staff paid via payroll will be reflected here. Exceptions to this will be any staff who are seconded into SCW from another organisation, anyone on a Redeployment Work Trial from another organisation, any Honorary contracts working for SCW and not paid by the organisation, individuals on the National Graduate Scheme not paid by SCW and any individuals working for SCW on work experience or internships.",
                    "textStyle": {
                      "fontFamily": "inherit",
                      "fontSize": "11pt",
                      "color": "inherit"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "inherit",
                      "fontSize": "11pt",
                      "color": "inherit"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "SCW staff who are seconded out of the organisation or are on a career break will still appear in the reporting structure as they retain a substantive post. Bank staff will appear in the reporting structure aligned to their line manager as set in ESR.",
                    "textStyle": {
                      "fontFamily": "inherit",
                      "fontSize": "11pt",
                      "color": "inherit"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "In additional line managers may be career managers not work allocation line managers. ",
                    "textStyle": {
                      "fontFamily": "inherit",
                      "fontSize": "11pt",
                      "color": "#000000"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              }
            ]
          }
        }
      ]
