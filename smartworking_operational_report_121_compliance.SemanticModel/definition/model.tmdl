model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectQuery to AS - semantic_model_smarttime"]

annotation PBI_ProTooling = ["DevMode"]

ref table data_smarttime
ref table base_date
ref table base_metadata_dynamic_structure_chart
ref table base_metadata_smarttime
ref table support_rls_dynamic

ref cultureInfo en-US

