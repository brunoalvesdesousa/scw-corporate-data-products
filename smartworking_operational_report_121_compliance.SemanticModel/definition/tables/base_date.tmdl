		annotation SummarizationSetBy = Automatic

	partition base_date = calculated
		mode: import
		source = ```
				
				VAR FYStart = "04"
				VAR todayreference = TODAY()
				VAR FirstYear = -- Customizes the first year to use
				    MIN(data_smarttime[Activity_Date])
				VAR LastYear = -- Customizes the last year to use
				    max(data_smarttime[Timesheet_End])
				RETURN
				ADDCOLUMNS (
				    FILTER (
				        CALENDARAUTO (),
				        AND([Date] >= FirstYear,[Date] <= todayreference)),
				    "Year", DATE ( YEAR ( [Date] ), 12, 31 ),
				    "Month Year", EOMONTH ( [Date], 0 ),
				    "Month", FORMAT ( [Date], "mmm" ),
				    "Month Number", MONTH ( [Date] ),
				    "Day of Week", FORMAT ( [Date], "dddd" ),
				    "Day of Week Number", WEEKDAY ( [Date],2),
				    "Day of the Month Number", DAY([Date]),
				    "Financial Year", IF(FYStart <= FORMAT([Date],"MM"), YEAR([Date]) & "-" & YEAR([Date])+1 ,YEAR([Date])-1 & "-" & YEAR([Date])),
				    "Financial Week Number", 
				        VAR CurrentDate = [Date]
				        VAR FinancialYearStart = DATE(YEAR(CurrentDate) + IF(MONTH(CurrentDate) < 4, -1, 0), 4, 1) // Adjust year for dates before April
				        RETURN
				            WEEKNUM(CurrentDate - FinancialYearStart + 1, 2), // Week number based on Financial Year start
				    "Financial Week Start",
				        VAR CurrentDate = [Date]
				        VAR FinancialYearStart = DATE(YEAR(CurrentDate) + IF(MONTH(CurrentDate) < 4, -1, 0), 4, 1)
				        VAR WeekNumber = WEEKNUM(CurrentDate - FinancialYearStart + 1, 2)
				        RETURN
				            FinancialYearStart + (WeekNumber - 1) * 7, // Calculate week start
				    "Financial Week End",
				        VAR CurrentDate = [Date]
				        VAR FinancialYearStart = DATE(YEAR(CurrentDate) + IF(MONTH(CurrentDate) < 4, -1, 0), 4, 1)
				        VAR WeekNumber = WEEKNUM(CurrentDate - FinancialYearStart + 1, 2)
				        RETURN
				            FinancialYearStart + WeekNumber * 7 - 1, // Calculate week end
				    "Financial Week Start Plus 7",
				         VAR CurrentDate = [Date]
				        VAR FinancialYearStart = DATE(YEAR(CurrentDate) + IF(MONTH(CurrentDate) < 4, -1, 0), 4, 1)
				        VAR WeekNumber = WEEKNUM(CurrentDate - FinancialYearStart + 1, 2)
				        RETURN
				            CALCULATE(FinancialYearStart + (WeekNumber - 1) * 7) + 7 //Week start + 7 days
				)
				```

	annotation PBI_Id = be176ea9c4394919bcf82e2d61d4fb85

