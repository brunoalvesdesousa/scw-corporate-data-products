  #"Expanded Sla_non_sla" = Table.ExpandRecordColumn(#"Removed columns", "Sla_non_sla", {"Value"}, {"Value"}),
  #"Renamed columns 1" = Table.RenameColumns(#"Expanded Sla_non_sla", {{"Value", "sla_non_sla"}}),
  #"Removed columns 1" = Table.RemoveColumns(#"Renamed columns 1", {"Version_no_id", "Secondary_developers", "CreatedBy", "ModifiedBy", "Attachments", "Author"}),
  #"Replaced value 1" = Table.ReplaceValue(#"Removed columns 1", " (NHS SOUTH, CENTRAL AND WEST COMMISSIONING SUPPORT UNIT)", "", Replacer.ReplaceText, {"ProductOwner.Name"}),
  #"Split column by delimiter" = Table.SplitColumn(#"Replaced value 1", "ProductOwner.Name", Splitter.SplitTextByDelimiter(","), {"ProductOwner.Name.1", "ProductOwner.Name.2"}),
  #"Replaced value 2" = Table.ReplaceValue(#"Split column by delimiter", " ", "", Replacer.ReplaceText, {"ProductOwner.Name.2"}),
  #"Added custom" = Table.TransformColumnTypes(Table.AddColumn(#"Replaced value 2", "ProductOwner", each [ProductOwner.Name.2] & " " & [ProductOwner.Name.1]), {{"ProductOwner", type text}}),
  #"Capitalized each word" = Table.TransformColumns(#"Added custom", {{"ProductOwner", each Text.Proper(_), type nullable text}}),
    #"Unpivoted Columns" = Table.UnpivotOtherColumns(#"Capitalized each word", {}, "Attribute", "Value"),
    #"Replaced Value" = Table.ReplaceValue(#"Unpivoted Columns",".value","",Replacer.ReplaceText,{"Attribute"}),
