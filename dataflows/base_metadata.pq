    #"Replaced Value3" = Table.ReplaceValue(#"Replaced Value2","0","",Replacer.ReplaceText,{"Attribute"}),
    #"Split Column by Character Transition" = Table.SplitColumn(#"Replaced Value3", "Attribute", Splitter.SplitTextByCharacterTransition({"a".."z"}, {"A".."Z"}), {"Attribute.1", "Attribute.2", "Attribute.3"}),
    #"Merged Columns" = Table.CombineColumns(#"Split Column by Character Transition",{"Attribute.1", "Attribute.2", "Attribute.3"},Combiner.CombineTextByDelimiter(" ", QuoteStyle.None),"Merged"),
    #"Renamed Columns" = Table.RenameColumns(#"Merged Columns",{{"Merged", "Attribute"}}),
  #"Changed column type" = Table.TransformColumnTypes(#"Renamed Columns", {{"Value", type text}})
in
    #"Changed column type";
