[StagingDefinition = [Kind = "FastCopy"]]
section Section1;
shared base_metadata_smarttime = let
    Source = SharePoint.Tables("https://nhs.sharepoint.com/sites/msteams_8489d9/", [ApiVersion = 14]),
    Products = Source{[Name="Products"]}[Content],
    #"Expanded Portfolio" = Table.ExpandTableColumn(Products, "Portfolio", {"Name"}, {"Portfolio.Name"}),
