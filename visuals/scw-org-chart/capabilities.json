{
  "dataRoles": [
    {
      "displayName": "Employee ID",
      "name": "employeeId",
      "kind": "Grouping"
    },
    {
      "displayName": "Manager ID",
      "name": "managerId",
      "kind": "Grouping"
    },
    {
      "displayName": "Full Name",
      "name": "name",
      "kind": "Grouping"
    },
    {
      "displayName": "Extra Details (Level 3, Level 6, Status)",
      "name": "Extra",
      "kind": "Grouping"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "employeeId": {
            "max": 1
          },
          "managerId": {
            "max": 1
          },
          "name": {
            "max": 1
          }
        }
      ],
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "employeeId"
              }
            },
            {
              "for": {
                "in": "managerId"
              }
            },
            {
              "for": {
                "in": "name"
              }
            },
            {
              "for": {
                "in": "Extra"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        }
      }
    }
  ],
  "supportsHighlight": true,
  "privileges": [],
  "objects": {
    "layoutSettings": {
      "displayName": "Layout & Navigation",
      "properties": {
        "DefaultLayout": {
          "displayName": "Tree Layout Mode",
          "type": {
            "enumeration": [
              { "displayName": "Dense Spine (2-Column Vertical)", "value": "compact" },
              { "displayName": "Horizontal (Left-to-Right)", "value": "horizontal" },
              { "displayName": "Classic Top-Down", "value": "classic" }
            ]
          }
        },
        "DefaultDensity": {
          "displayName": "Card Size & Density",
          "type": {
            "enumeration": [
              { "displayName": "Mini (Ultra-Compact)", "value": "mini" },
              { "displayName": "Compact (Recommended)", "value": "compact" },
              { "displayName": "Detailed (Large Cards)", "value": "detailed" }
            ]
          }
        },
        "AccordionMode": {
          "displayName": "Accordion Mode (Auto-Collapse Siblings)",
          "type": {
            "bool": true
          }
        },
        "AutoFitOnToggle": {
          "displayName": "Auto-Fit Page on Expand/Collapse",
          "type": {
            "bool": true
          }
        },
        "ShowMinimap": {
          "displayName": "Show Corner Minimap",
          "type": {
            "bool": true
          }
        }
      }
    },
    "dataCard": {
      "displayName": "Node Card & Font Sizing",
      "properties": {
        "CardTheme": {
          "displayName": "Card Color Theme",
          "type": {
            "enumeration": [
              { "displayName": "SCW Dark Navy (#1C355E)", "value": "navy" },
              { "displayName": "NHS Light White", "value": "light" }
            ]
          }
        },
        "NodeBackgroundColor": {
          "displayName": "Custom Card Background",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "FontSizeScale": {
          "displayName": "Font Size Scale (%)",
          "type": {
            "numeric": true
          }
        },
        "CardSizeScale": {
          "displayName": "Box Size Scale (%)",
          "type": {
            "numeric": true
          }
        },
        "MaxColumnsWrap": {
          "displayName": "Max Columns per Row (Expanded Branches)",
          "type": {
            "numeric": true
          }
        },
        "ShowID": {
          "displayName": "Show Person ID",
          "type": {
            "bool": true
          }
        }
      }
    },
    "SearchSettings": {
      "displayName": "Search Settings",
      "properties": {
        "SearchHighlightColor": {
          "displayName": "Search Highlight Color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    }
  }
}
