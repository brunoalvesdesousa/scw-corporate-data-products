table data_smarttime
	lineageTag: da5ede5f-b391-47d2-85a2-b676b9854734

	measure calc_workingdays =
			
			VAR StartDate = CALCULATE(MIN(data_smarttime[Activity_Date]),ALLSELECTED())
			VAR EndDate = CALCULATE(MAX(data_smarttime[Activity_Date]),ALLSELECTED())
			VAR DateTable = CALENDAR(StartDate, EndDate)
			VAR WorkingDaysTable = FILTER(DateTable, WEEKDAY([Date], 2) <= 5)
			RETURN COUNTROWS(WorkingDaysTable)
		formatString: 0
		lineageTag: 01c78df4-1dfa-46a7-8c63-a1bb971f2676

	measure calc_contractedhours =
			
			(AVERAGE(data_smarttime[Person_Hours_Per_Week])/5)*[calc_workingdays]
		lineageTag: 37288a89-1af3-4a8f-bade-9a1adb964c51

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure calc_timesheet_count = ```
			
			    DISTINCTCOUNT(data_smarttime[Timesheet_Id])
			```
		formatString: 0
		lineageTag: bf817def-f5b4-48fa-885e-f8cabb819475

		changedProperty = Name

	measure calc_compliance =
			
			1-
			DIVIDE(
			    CALCULATE([calc_timesheet_count],data_smarttime[calc_lateness]="unsubmitted"),
			    [calc_timesheet_count]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d04bbf45-d524-4e95-a4cd-9a38f4079039

		changedProperty = Name

		changedProperty = FormatString

	measure calc_submitted_timesheets = ```
			
			CALCULATE(
			    [calc_timesheet_count],
			    data_smarttime[calc_lateness] = "late" || data_smarttime[calc_lateness] = "on time"
			)
			
			```
		formatString: 0
		lineageTag: dff6daef-f276-4d72-aefc-546ba50ab832

		changedProperty = Name

	measure calc_unsubmitted_timesheets =
			
			CALCULATE(
			    [calc_timesheet_count],
			    data_smarttime[calc_lateness] = "unsubmitted"
			)
		formatString: 0
		lineageTag: afc460f9-d90c-4990-9dba-ff2543443c53

		changedProperty = Name

	measure calc_submitted_hours =
			
			CALCULATE(
			    [calc_total_activity_hours],
			    data_smarttime[calc_lateness] = "late" || data_smarttime[calc_lateness] = "on time"
			)
		lineageTag: 2c4a48d7-595e-4837-8a63-50db8cb39277

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure calc_unsubmitted_hours =
			
			CALCULATE(
			    [calc_total_activity_hours],
			    data_smarttime[calc_lateness] = "unsubmitted"
			)
		lineageTag: 5512237d-dab8-421c-9110-350e34db7823

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure calc_total_activity_hours =
			
			SUM(data_smarttime[Activity_Hours])
		lineageTag: 5842e62f-3e4e-4cc1-8981-8a97ee92f465

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure calc_smarttime_days_invoiceable = ```
			
			    CALCULATE(
			        SUM(data_smarttime[calc_smarttime_days]),
			        data_smarttime[Activity_Non_Invoiceable]=FALSE
			    )
			```
		formatString: 0.00
		lineageTag: 2c6c5662-df9e-40c9-ba44-4826f072a2d9

		changedProperty = FormatString

	measure calc_smarttime_days_non_invoiceable = ```
			
			    CALCULATE(
			        SUM(data_smarttime[calc_smarttime_days]),
			        data_smarttime[Activity_Non_Invoiceable]=TRUE
			    )
			```
		formatString: #,0.00
		lineageTag: 16bde7db-80fb-4f7d-b73c-c7f9d763f0c0

		changedProperty = Name

		changedProperty = FormatString

	measure calc_activity_start_date = ```
			
			    CALCULATE(MIN(data_smarttime[Activity_Date]),
			    REMOVEFILTERS(data_smarttime[Activity_Date])
			    )
			```
		formatString: General Date
		lineageTag: 936bf363-8b54-49f9-bfef-2478229afad5

		changedProperty = Name

	measure calc_NonWorkingHours =
			
			CALCULATE(
			    SUM('data_smarttime'[Activity_Hours]),
			    FILTER((data_smarttime),data_smarttime[Work_Activity_Type] = "Non-Working")
			)
		lineageTag: 83e6aadf-3809-452f-afd8-88f73721b7dd

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'calc_contractedhours minus calc_NonWorkingHours' =
			
			[calc_contractedhours] - [calc_NonWorkingHours]
		lineageTag: 4ef607b5-79cd-4b64-840a-a533b5f39ccb

		changedProperty = Name

