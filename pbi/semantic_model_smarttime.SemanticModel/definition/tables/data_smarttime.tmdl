		displayFolder: _Calculations\Compliance
		lineageTag: 20ab7e30-3e9a-4ce3-bd1d-6eacc982278e

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure calc_121_compliance_ActiveStaff = ```
			
			-- 1. Get the list of people in the current context
			VAR PeopleInContext =
			    VALUES ( data_smarttime[Person_Id] )
			
			-- 2. Get the list of all months in the current context
			VAR MonthsInContext =
			    VALUES ( base_date[Month Year] )
			
			-- 3. DENOMINATOR: Create a grid of all (Person, Month) pairs and count only the ones that were "active" (had *any* activity)
			VAR expected_121 =
			    COUNTROWS (
			        FILTER (
			            CROSSJOIN ( PeopleInContext, MonthsInContext ),
			            -- This checks if the (Person, Month) pair has at least one timesheet entry of any kind
			            CALCULATE ( COUNTROWS ( data_smarttime ) ) > 0
			        )
			    )
			
			-- 4. NUMERATOR: Create the same grid, but count only the ones that were "compliant" (had the 7016 activity)
			VAR received_121 =
			    COUNTROWS (
			        FILTER (
			            CROSSJOIN ( PeopleInContext, MonthsInContext ),
			            -- This checks if the (Person, Month) pair has at least one '7016' activity
			            CALCULATE (
			                COUNTROWS ( data_smarttime ),
			                data_smarttime[Work_Activity_Id] = 7016
			            ) > 0
			        )
			    )
			
			-- 5. Calculate the final rate
			RETURN  
			    DIVIDE( received_121, expected_121)
			        
			```
		formatString: 0%;-0%;0%
		displayFolder: _Calculations\Compliance
		lineageTag: 1c489949-5106-4ad4-abf7-bee715edd38a

		changedProperty = FormatString

		changedProperty = Name

	measure calc_121_compliance_ActiveStaff_cond_tickmark =
			
			-- 1. Get the list of people in the current context
			VAR PeopleInContext =
			    VALUES ( data_smarttime[Person_Id] )
			
			-- 2. Get the list of all months in the current context
			VAR MonthsInContext =
			    VALUES ( base_date[Month Year] )
			
			-- 3. DENOMINATOR: Create a grid of all (Person, Month) pairs and count only the ones that were "active" (had *any* activity)
			VAR expected_121 =
			    COUNTROWS (
			        FILTER (
			            CROSSJOIN ( PeopleInContext, MonthsInContext ),
			            -- This checks if the (Person, Month) pair has at least one timesheet entry of any kind
			            CALCULATE ( COUNTROWS ( data_smarttime ) ) > 0
			        )
			    )
			
			-- 4. NUMERATOR: Create the same grid, but count only the ones that were "compliant" (had the 7016 activity)
			VAR received_121 =
			    COUNTROWS (
			        FILTER (
			            CROSSJOIN ( PeopleInContext, MonthsInContext ),
			            -- This checks if the (Person, Month) pair has at least one '7016' activity
			            CALCULATE (
			                COUNTROWS ( data_smarttime ),
			                data_smarttime[Work_Activity_Id] = 7016
			            ) > 0
			        )
			    )
			
			-- 5. Calculate the final rate
			RETURN
			    IF(
			        DIVIDE( received_121, expected_121 )>=1,
			        UNICHAR(10003),
			        DIVIDE( received_121, expected_121)
			        )
		formatString: 0%;-0%;0%
		displayFolder: _Calculations\Compliance
		lineageTag: 6ef832b4-4529-440d-88b1-cc47d58f75d9

		changedProperty = Name

		changedProperty = FormatString

