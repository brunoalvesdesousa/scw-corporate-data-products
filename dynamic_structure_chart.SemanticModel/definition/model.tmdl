model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectQuery to AS - semantic_model_smarttime","0_Environment"]

annotation PBI_ProTooling = ["DevMode"]

ref table 0_Environment
ref table support_rls_hierarchy_gold
ref table base_metadata_dynamic_structure_chart

ref cultureInfo en-US

