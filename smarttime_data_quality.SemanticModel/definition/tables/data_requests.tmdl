table data_requests
	lineageTag: 933e05a3-8d26-4033-9932-b5fe58ecab8a

	measure calc_no_requests = COUNT(data_requests[Id])
		formatString: 0
		lineageTag: 411be279-1cb8-4f53-85c2-6d137ccc796f

		annotation PBI_FormatHint = {"isDecimal":true}

	measure calc_late_requests =
			
			if(
			    ISBLANK(
			        CALCULATE([calc_no_requests],data_requests[calc_ontime_vs_late] = "late")
			    ),
			    0,
			    CALCULATE([calc_no_requests],data_requests[calc_ontime_vs_late] = "late")
			)
		formatString: 0
		lineageTag: e1f70768-c2ec-40e4-afc5-d9f67dc92956

