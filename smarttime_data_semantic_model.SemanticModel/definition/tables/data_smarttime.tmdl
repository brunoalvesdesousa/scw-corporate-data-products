table data_smarttime
	lineageTag: da5ede5f-b391-47d2-85a2-b676b9854734

	measure calc_workingdays =
			
			VAR StartDate = CALCULATE(MIN(data_smarttime[Activity_Date]),ALLSELECTED())
			VAR EndDate = CALCULATE(MAX(data_smarttime[Activity_Date]),ALLSELECTED())
			VAR DateTable = CALENDAR(StartDate, EndDate)
			VAR WorkingDaysTable = FILTER(DateTable, WEEKDAY([Date], 2) <= 5)
			RETURN COUNTROWS(WorkingDaysTable)
		formatString: 0
		displayFolder: _Calculations
		lineageTag: 01c78df4-1dfa-46a7-8c63-a1bb971f2676

	measure calc_contractedhours =
			
			(AVERAGE(data_smarttime[Person_Hours_Per_Week])/5)*[calc_workingdays]
		displayFolder: _Calculations\Finance
		lineageTag: 37288a89-1af3-4a8f-bade-9a1adb964c51

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure calc_timesheet_count = ```
			
