	measure calc_timesheet_expected_hours =
			
			VAR StartDate =
			    CALCULATE(
			        MIN(data_smarttime[Activity_Date]),
			        ALLSELECTED(data_smarttime[Activity_Date])
			    )
			VAR SlicerEndDate = -- The last date selected in the slicer
			    CALCULATE(
			        MAX(data_smarttime[Activity_Date]),
			        ALLSELECTED(data_smarttime[Activity_Date])
			    )
			
			-- Use the slicer's end date OR today, whichever is earlier.
			VAR EffectiveEndDate = MIN(SlicerEndDate, TODAY())
			
			-- Only calculate if the period is not entirely in the future
			VAR IsPeriodStarted = StartDate <= EffectiveEndDate
			
			VAR NumberOfDays = DATEDIFF(StartDate, EffectiveEndDate, DAY) + 1
			VAR NumberOfWeeks = NumberOfDays / 7.0
			VAR ContractedHoursPerWeek = min(data_smarttime[Person_Hours_Per_Week])
			
			RETURN
			IF(
			    IsPeriodStarted,
			    NumberOfWeeks * ContractedHoursPerWeek
			)
		displayFolder: _Calculations\Timesheets
		lineageTag: b6f604f3-1c51-46bb-8af0-378a6e54b4ce

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MonthlyExpectedHours = (max(data_smarttime[DailyExpectedHours]) * [Count_Days_in_Month])
		displayFolder: _Calculations\Compliance
		lineageTag: 8e2aadc1-88e2-48f3-ae5d-a35d6581d32c

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure calc_121_compliance_ActiveStaff = ```
			
			-- 1. Get the list of people in the current context
			VAR PeopleInContext =
			    VALUES ( data_smarttime[Person_Id] )
			
			-- 2. Get the list of all months in the current context
			VAR MonthsInContext =
			    VALUES ( base_date[Month Year] )
			
			-- 3. DENOMINATOR: Create a grid of all (Person, Month) pairs and count only the ones that were "active" (had *any* activity)
			VAR expected_121 =
			    COUNTROWS (
			        FILTER (
			            CROSSJOIN ( PeopleInContext, MonthsInContext ),
			            -- This checks if the (Person, Month) pair has at least one timesheet entry of any kind
			            CALCULATE ( COUNTROWS ( data_smarttime ) ) > 0
			        )
			    )
			
			-- 4. NUMERATOR: Create the same grid, but count only the ones that were "compliant" (had the 7016 activity)
			VAR received_121 =
			    COUNTROWS (
			        FILTER (
			            CROSSJOIN ( PeopleInContext, MonthsInContext ),
			            -- This checks if the (Person, Month) pair has at least one '7016' activity
			            CALCULATE (
			                COUNTROWS ( data_smarttime ),
			                data_smarttime[Work_Activity_Id] = 7016
			            ) > 0
			        )
			    )
			
			-- 5. Calculate the final rate
			RETURN  
			    DIVIDE( received_121, expected_121)
			        
			```
		formatString: 0%;-0%;0%
		displayFolder: _Calculations\Compliance
		lineageTag: fac849a2-74b9-4f8e-97d4-661894b05454

		changedProperty = FormatString

		changedProperty = Name

	measure calc_121_compliance_ActiveStaff_cond_tickmark =
			
			-- 1. Get the list of people in the current context
			VAR PeopleInContext =
			    VALUES ( data_smarttime[Person_Id] )
			
			-- 2. Get the list of all months in the current context
			VAR MonthsInContext =
			    VALUES ( base_date[Month Year] )
			
			-- 3. DENOMINATOR: Create a grid of all (Person, Month) pairs and count only the ones that were "active" (had *any* activity)
			VAR expected_121 =
			    COUNTROWS (
			        FILTER (
			            CROSSJOIN ( PeopleInContext, MonthsInContext ),
			            -- This checks if the (Person, Month) pair has at least one timesheet entry of any kind
			            CALCULATE ( COUNTROWS ( data_smarttime ) ) > 0
			        )
			    )
			
			-- 4. NUMERATOR: Create the same grid, but count only the ones that were "compliant" (had the 7016 activity)
			VAR received_121 =
			    COUNTROWS (
			        FILTER (
			            CROSSJOIN ( PeopleInContext, MonthsInContext ),
			            -- This checks if the (Person, Month) pair has at least one '7016' activity
			            CALCULATE (
			                COUNTROWS ( data_smarttime ),
			                data_smarttime[Work_Activity_Id] = 7016
			            ) > 0
			        )
			    )
			
			-- 5. Calculate the final rate
			RETURN
			    IF(
			        DIVIDE( received_121, expected_121 )>=1,
			        UNICHAR(10003),
			        DIVIDE( received_121, expected_121)
			        )
		formatString: 0%;-0%;0%
		displayFolder: _Calculations\Compliance
		lineageTag: de1ce0a8-4e2c-4734-a8c2-519dffc1edaa

		changedProperty = Name

		changedProperty = FormatString

