	measure calc_late_timesheets_% =
			
			[calc_late_timesheets]/(DISTINCTCOUNT(base_date[Financial Week Start])*DISTINCTCOUNT(data_smarttime[Person_Id]))
		formatString: 0.00%;-0.00%;0.00%
