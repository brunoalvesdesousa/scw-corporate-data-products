	column calc_timesheet_due_by =
			
			data_smarttime[Timesheet_Start]+7
		formatString: General Date
		displayFolder: _Calculations\Timesheets
		lineageTag: 40047870-7abc-484c-87ad-3b6884cd7121
		summarizeBy: none

		variation Variation
			isDefault
			relationship: cdd637e7-cd21-4703-8143-391698d534fd
			defaultHierarchy: LocalDateTable_8336a70e-f0f5-4f02-a99f-3918dbe434a8.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column calc_hierarchy_path = ```
			
			    RELATED(support_rls_merged[hierarchy_path])
			```
		displayFolder: _Calculations
		lineageTag: 0474cb19-706f-4313-9ff0-55aa5e15d25e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column calc_burn_invoiceable =
			
			IF(
			    data_smarttime[Activity_Non_Invoiceable]=FALSE,
			    data_smarttime[Day_Rate]*data_smarttime[calc_smarttime_days],
			    0
			)
		displayFolder: _Calculations\Finance
		lineageTag: 91cb5126-a2c4-4d60-bf0b-1d38990cc0dd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column calc_burn_non_invoiceable =
			
			IF(
			    data_smarttime[Activity_Non_Invoiceable]=TRUE,
			    data_smarttime[Day_Rate]*data_smarttime[calc_smarttime_days],
			    0
			)
		displayFolder: _Calculations\Finance
		lineageTag: 980c8985-f28c-4f92-b6ac-135329f3b88a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column calc_lateness = ```
			
			IF(
			    AND(
			        ISBLANK(data_smarttime[calc_timesheet_due_by]),
			        ISBLANK(data_smarttime[Timesheet_Closed_Date])
			    ),
			    "not due",
			   IF(
			           ISBLANK(data_smarttime[Timesheet_Closed_Date]) &&
			           NOT(ISBLANK(data_smarttime[calc_timesheet_due_by])) &&
			           data_smarttime[calc_timesheet_due_by]<TODAY(),        
			        "unsubmitted",
			        IF(
			            DATEDIFF(data_smarttime[calc_timesheet_due_by],data_smarttime[Timesheet_Closed_Date],DAY)>=1,
			            "late",
			            "on time"
			        )
			    ))
			```
		displayFolder: _Calculations\Timesheets
		lineageTag: d2dc6c50-c355-4691-b583-eb0b8736d1a5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column calc_lateness_conditional_formatting = ```
			
			IF(
			    AND(
			        ISBLANK(data_smarttime[calc_timesheet_due_by]),
			        ISBLANK(data_smarttime[Timesheet_Closed_Date])
			    ),
			    "grey",
			    IF(
			            ISBLANK(data_smarttime[Timesheet_Closed_Date]) &&
			            NOT(ISBLANK(data_smarttime[calc_timesheet_due_by])) &&
			            data_smarttime[calc_timesheet_due_by]<TODAY(),        
			        "red",
			        IF(
			            DATEDIFF(data_smarttime[calc_timesheet_due_by],data_smarttime[Timesheet_Closed_Date],DAY)>=1,
			            "orange",
			            ""
			        )
			    )
			)
			```
		displayFolder: _Calculations\Timesheets
		lineageTag: b575a658-23b4-40b4-bd3b-53dc394d46e0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column calc_smarttime_days = data_smarttime[Activity_Hours]/7.5
		displayFolder: _Calculations
		lineageTag: 29990d9d-eab1-4828-bc51-d0ddcc25f543
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column %SmartTimeCompliance_daily = ```
			
			    DIVIDE(
			        data_smarttime[Activity_Hours],
			        data_smarttime[DailyExpectedHours],
			        0)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: _Calculations\Compliance
