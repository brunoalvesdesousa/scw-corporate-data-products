	partition base_date = calculated
		mode: import
		source = ```
				
				VAR FYStartMonth = 4 -- Financial Year starts in April
				VAR todayreference = TODAY()
				VAR FirstYear = MIN(data_smarttime[Activity_Date])
				RETURN
				ADDCOLUMNS (
				    FILTER (
				        CALENDARAUTO (),
				        [Date] >= FirstYear && [Date] <= todayreference
				    ),
				    "Year", DATE ( YEAR ( [Date] ), 12, 31 ),
				    "Month Year", EOMONTH ( [Date], 0 ),
				    "Month", FORMAT ( [Date], "mmm" ),
				    "Month Number", MONTH ( [Date] ),
				    "Day of Week", FORMAT ( [Date], "dddd" ),
				    "Day of Week Number", WEEKDAY ( [Date], 2 ), -- Monday = 1, Sunday = 7
				    "Day of the Month Number", DAY([Date]),
				    "Financial Year", 
				        IF(
				            MONTH([Date]) >= FYStartMonth, 
				            YEAR([Date]) & "-" & YEAR([Date]) + 1,
				            YEAR([Date]) - 1 & "-" & YEAR([Date])
				        ),
				    "Financial Week Number", 
				        VAR CurrentDate = [Date]
				        VAR FY_Start_Date =
				            DATE (
				                YEAR ( CurrentDate ) + IF ( MONTH ( CurrentDate ) < FYStartMonth, -1, 0 ),
				                FYStartMonth,
				                1
				            )
				        VAR Anchor_Week_Start = FY_Start_Date - WEEKDAY ( FY_Start_Date, 2 ) + 1
				        VAR Current_Week_Start = CurrentDate - WEEKDAY ( CurrentDate, 2 ) + 1
				        RETURN
				            INT ( DATEDIFF ( Anchor_Week_Start, Current_Week_Start, DAY ) / 7 ) + 1,
				    "Financial Week Start",
				        -- Calculates the date of the Monday for the given row's date
				        [Date] - WEEKDAY ( [Date], 2 ) + 1,
				    "Financial Week End",
				        -- Adds 6 days to the week start to get the Sunday
				        ( [Date] - WEEKDAY ( [Date], 2 ) + 1 ) + 6,
				    "Financial Week Start Plus 7",
				        -- Adds 7 days to the week start to get the following Monday
				        ( [Date] - WEEKDAY ( [Date], 2 ) + 1 ) + 7
				)
				```

	annotation PBI_Id = 8064dce50df34027a4d52dbe7ed7b411

