  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Methodology:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#005eb8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Data extracted from SaleForce via an API and automated refresh set via an ETL (extract, transform, load) process.",
                    "textStyle": {
                      "color": "#000000"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Data extracted from SmartTime via an internal database (in a flattened format)",
                    "textStyle": {
                      "color": "#000000"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Data extracted from oracle onto CSV format, extra information manually added to the extracted CSV",
                    "textStyle": {
                      "color": "#000000"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "CSV files uploaded include agency cost rates and staff with no recognised band cost rates. This enables data on costs not currently populated, in these areas, to be determined"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Data has been linked using the opportunity number. The plan would be to switch to the sales contract ID when this is has been populated"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "The customer is linked between systems using the Oracle code. The customer name displayed is the name shown in Salesforce which may be different to how the name is shown in the SmartTime or Oracle systems"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "The three datasets are then loaded into PowerBI via native connections and further transformed and modeled in order to fit the request",
                    "textStyle": {
                      "color": "#000000"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Caveats",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#005eb8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The following datasets have been truncated:"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "SmartTime: data loaded after April 2023"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Oracle income: data loaded after April 2023"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Staff cost rate is determined by their band, if they have a second assignment at a different rate the cost will still be calculated at the primary rate",
                    "textStyle": {
                      "color": "#000000"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Only transactions that have a opportunity number recognised in Salesforce are included. This means that currently (@ Sept 23) contracts like Connecting Care that are not on Salesforce will not be included either for income or non pay. The intention is that all income will have an opportunity number and ultimately a sales contract ID. Plan to build exception tables to show those items with no salesforce opportunity reference"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              }
            ]
          }
        }
